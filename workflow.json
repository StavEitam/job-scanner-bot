        "jsCode": "const text = $json.message.text || '';\nconst withoutCmd = text.replace(/^\\/scan\\s*/i, '').trim();\nconst titles = withoutCmd.length > 0\n  ? withoutCmd.split(',').map(t => t.trim()).filter(t => t.length > 0)\n  : ['Product Analyst', 'Analyst', 'Customer Success', 'User Acquisition', 'GenAI'];\nreturn titles.map(title => ({ json: { title } }));"
