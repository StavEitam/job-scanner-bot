    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst out = [];\nfor (const it of items) {\n  const d = it.json || {};\n  const title = d.title || d.jobTitle || d.positionName || d.position || d.name || '';\n  const company = d.company || d.companyName || d.employer || d.company_name || '';\n  const link = d.link || d.url || d.jobUrl || d.applyUrl || d.job_url || d.externalUrl || '';\n  const description = d.description || d.jobDescription || d.descriptionText || d.description_text || d.snippet || d.text || '';\n  const location = d.location || d.jobLocation || d.place || d.city || '';\n  const rawId = d.id || d.jobId || d.job_id || link || (String(title) + '|' + String(company));\n  out.push({ json: {\n    job_id: String(rawId),\n    title: String(title),\n    company: String(company),\n    link: String(link),\n    location: String(location),\n    description: String(description),\n  }});\n}\nreturn out;"
      },
      "id": "e43edf4a-ba6c-418c-8fbf-a9783411ce6a",
      "name": "Normalize Jobs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1328,
        288
      ]
    },
    {
      "parameters": {
        "jsCode": "const seniorPattern = /\\b(senior|sr\\.?|lead|principal|staff|head of|director|vp|vice president|chief|ceo|cto|cfo)\\b/i;\nconst seniorPatternHe = /(בכיר|סמנכ\"?ל|מנכ\"?ל|ראש תחום|ראש צוות)/;\n\nconst items = $input.all();\nreturn items.filter(it => {\n  const title = String(it.json.title || '');\n  return !seniorPattern.test(title) && !seniorPatternHe.test(title);\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1536,
        288
      ],
      "id": "533a5347-8f5d-47ee-ae87-d6b3709d0b95",
      "name": "Keyword Pre-Filter"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nif (items.length === 0) return [];\n\nconst seen = new Set();\nconst jobsList = [];\nfor (const it of items) {\n  const id = String(it.json.job_id);\n  if (seen.has(id)) continue;\n  seen.add(id);\n  jobsList.push({\n    job_id: it.json.job_id,\n    title: it.json.title,\n    company: it.json.company,\n    location: it.json.location,\n    link: it.json.link,\n    description: String(it.json.description || '').slice(0, 8000),\n  });\n}\n\nconst CHUNK_SIZE = 35;\nconst chunks = [];\nfor (let i = 0; i < jobsList.length; i += CHUNK_SIZE) {\n  chunks.push(jobsList.slice(i, i + CHUNK_SIZE));\n}\n\nreturn chunks.map((chunk) => {\n  const promptText = chunk.map((j, idx) =>\n    `Job ${idx + 1} (id: ${j.job_id}):\\nTitle: ${j.title}\\nCompany: ${j.company}\\nLocation: ${j.location}\\nDescription:\\n${j.description}\\n`\n  ).join('\\n---\\n');\n  return { json: { batchPrompt: promptText, jobCount: chunk.length, jobs: chunk } };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1744,
        288
      ],
      "id": "48cdef2a-f3ca-48c8-ac71-8e11a6617616",
      "name": "Build Batch Prompt"
    },
    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "value": "claude-haiku-4-5-20251001",
          "mode": "list",
          "cachedResultName": "claude-haiku-4-5-20251001"
        },
        "messages": {
          "values": [
            {
              "content": "=Evaluate the following {{ $json.jobCount }} jobs:\n\n{{ $json.batchPrompt }}"
            }
          ]
        },
        "options": {
          "system": "=You are a job-matching assistant. Job descriptions may be in Hebrew or English; handle both.\n\nThe user is currently searching for jobs matching ANY of these requested roles: {{ $('Parse Titles').all().map(i => i.json.title).join(', ') }}\n\nEvaluate each job against these criteria:\n1. Title relevance — the job's actual title should reasonably correspond to one of the requested roles above, OR be a clear synonym/close variant of one of them. Do not require exact string match, but reject roles that are clearly unrelated.\n2. Experience level — HARD REQUIREMENT: the candidate has at most 2 years of experience. Reject (match=\"no\") any job that requires more than 2 years of experience, or that is titled/described as Senior, Lead, Principal, Head of, Manager (people-management), Director, or similarly senior-level — even if the title otherwise matches. Accept roles explicitly labeled Junior, Entry-level, Associate, Graduate, or with no seniority qualifier and no explicit years-required above 2.\n3. Relevant technologies mentioned, if any are implied by the requested role.\n4. Remote or hybrid status is a plus but not mandatory.\n\nReturn ONLY a JSON array, no markdown, no code fences. Include exactly one element per job listed above, using its exact id value, in this shape: {\"job_id\":\"\",\"match\":\"yes\",\"score\":0,\"reason\":\"\"}.\n\"match\" is \"yes\" only if BOTH criterion 1 (title relevance) AND criterion 2 (experience ≤2 years / not senior-level) are satisfied; otherwise \"no\".\n\"score\" is an integer 0-100 reflecting overall fit across all 4 criteria.\n\"reason\" is a short explanation (max 200 chars) — mention which requested role it matched and why.",
          "maxTokens": 8000,
          "temperature": 0
        }
      },
      "id": "073e682d-b1f2-4a2e-87a3-d64df7f6baf6",
      "name": "AI Match Decision",
      "type": "@n8n/n8n-nodes-langchain.anthropic",
      "typeVersion": 1,
      "position": [
        1968,
        288
      ],
      "credentials": {
        "anthropicApi": {
          "id": "YOUR_ANTHROPIC_CREDENTIAL_ID",
          "name": "Anthropic account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const responses = $input.all();\nconst buildItems = $('Build Batch Prompt').all();\n\nconst out = [];\nfor (let i = 0; i < responses.length; i++) {\n  const resp = responses[i].json;\n  let text = '';\n  if (resp) {\n    if (typeof resp.content === 'string') text = resp.content;\n    else if (Array.isArray(resp.content) && resp.content[0]) text = resp.content[0].text || '';\n    else if (typeof resp.text === 'string') text = resp.text;\n  }\n  text = String(text).replace(/```json/gi, '').replace(/```/g, '').trim();\n\n  let decisions = [];\n  try { decisions = JSON.parse(text); } catch (e) { decisions = []; }\n\n  const jobs = buildItems[i]?.json?.jobs || [];\n  const byId = {};\n  jobs.forEach(j => byId[String(j.job_id)] = j);\n\n  for (const d of decisions) {\n    const job = byId[String(d.job_id)];\n    if (!job) continue;\n    out.push({ json: {\n      job_id: job.job_id,\n      title: job.title,\n      company: job.company,\n      link: job.link,\n      location: job.location,\n      match: String(d.match || 'no').toLowerCase(),\n      score: d.score != null ? d.score : 0,\n      reason: d.reason || '',\n    }});\n  }\n}\nreturn out;"
      },
