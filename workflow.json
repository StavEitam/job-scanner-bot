      "parameters": {
        "jsCode": "const sheetRows = $input.all()\n  .filter(i => i.json && i.json.job_id !== undefined && i.json.job_id !== null && String(i.json.job_id).length > 0)\n  .map(i => String(i.json.job_id));\nconst existing = new Set(sheetRows);\nconst jobs = $('Filter Matches Only').all();\nconst out = [];\nfor (const j of jobs) {\n  const id = String(j.json.job_id);\n  if (!existing.has(id)) {\n    existing.add(id);\n    out.push({ json: j.json });\n  }\n}\nreturn out;"
